# Guardian Transit AI - Environment Configuration

# Project Metadata
PROJECT_NAME="Guardian Transit AI"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardian_transit_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/guardian_transit_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardian_transit_db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-guardian-transit-ai-change-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
